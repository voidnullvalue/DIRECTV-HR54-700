#!/bin/sh
set -eu
UC=/opt/middleware_core/system/tv/uconntest
screen=$($UC '<com.directv.druid.dt.DruidTester command="getCurrentScreenId" session="local"/>' 2>&1) || :
case "$screen" in *'Current screenId for session 0 is '*) ;; *) exit 1;; esac
for attempt in 1 2 3 4 5 6 7 8; do
  screen=$($UC '<com.directv.druid.dt.DruidTester command="getCurrentScreenId" session="local"/>' 2>&1) || :
  case "$screen" in *'session 0 is 10306'*) exit 0;; esac
  wget -qO- 'http://127.0.0.1:8080/remote/processKey?key=menu&hold=keyPress' >/dev/null 2>&1 || :
  sleep 3
done
screen=$($UC '<com.directv.druid.dt.DruidTester command="getCurrentScreenId" session="local"/>' 2>&1) || :
case "$screen" in *'session 0 is 10306'*) exit 0;; esac
exit 1
